# Anthropic API (for Claude NLP parsing)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Calendar API (service account)
GOOGLE_CREDENTIALS_PATH=credentials/service-account.json
FAMILY_CALENDAR_ID=your-shared-family-calendar-id@group.calendar.google.com

# RubotPaul HMAC bearer auth (shared with the RubotPaul caller)
RUBOTPAUL_SHARED_SECRET=your-rubotpaul-shared-secret

# Standalone API port (binds 127.0.0.1 on the VPS)
SCHEDULE_MINION_API_PORT=8003
